e":"<math>\\phi^{-1}(h_2)</math>","span":[3768,3795]},{"form":"math","tex":"\\phi^{-1}(h_1 h_2)","source":"<math>\\phi^{-1}(h_1 h_2)</math>","span":[3813,3844]},{"form":"math","tex":"G/N","source":"<math>G/N</math>","span":[3876,3892]},{"form":"math","tex":"G","source":"<math>G</math>","span":[3954,3968]},{"form":"math","tex":"N","source":"<math>N</math>","span":[4036,4050]},{"form":"math","tex":"n\\in N","source":"<math>n\\in N</math>","span":[4062,4081]},{"form":"math","tex":"g\\in G,","source":"<math>g\\in G,</math>","span":[4086,4106]},{"form":"math","tex":"[n,g] = n^{-1} g^{-1} n g","source":"<math>[n,g] = n^{-1} g^{-1} n g</math>","span":[4126,4164]},{"form":"math","tex":"N.","source":"<math>N.</math>","span":[4171,4186]},{"form":"math","tex":"g, h \\in G,","source":"<math>g, h \\in G,</math>","span":[4302,4326]},{"form":"math","tex":"g h \\in N","source":"<math>g h \\in N</math>","span":[4327,4349]},{"form":"math","tex":"h g \\in N.","source":"<math>h g \\in N.</math>","span":[4365,4388]}],"links":[{"title":"Subgroup"},{"title":"Inner automorphism"},{"title":"Logical equivalence"},{"title":"Coset"},{"title":"Union (set theory)"},{"title":"Conjugacy class"},{"title":"Group homomorphism"},{"title":"Kernel (algebra)"},{"title":"Fiber (mathematics)"},{"title":"Congruence relation"},{"title":"Equivalence class"},{"title":"Identity element"},{"title":"Commutator"}],"citations":["o6","o8","o9","o10","o11","o12","o13","o14"],"hash":"sha256:62cdfbe6518bdc13f3835b6dbe5a575dd5c056fc0bb8a4953eb98b0198837b01","flags":["citation-needed"],"extractor":"m2/v0.3.8"}
